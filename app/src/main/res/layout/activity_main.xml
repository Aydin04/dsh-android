<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d1117">

    <!-- WebView Container -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Draggable Floating Container -->
    <LinearLayout
        android:id="@+id/floatingDraggableContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Horizontal Scrollable Toolbar to prevent any button from clipping -->
        <HorizontalScrollView
            android:id="@+id/controlBarScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_bar"
            android:elevation="9dp"
            android:fadeScrollbars="true"
            android:overScrollMode="never"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/controlBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnZoomOut"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="-"
                    android:textColor="#58a6ff"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvZoomLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="70%"
                    android:textColor="#f0f6fc"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnZoomIn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="+"
                    android:textColor="#58a6ff"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="#30363d" />

                <Button
                    android:id="@+id/btnRefreshWeb"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="🔄"
                    android:textColor="#f0f6fc"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnDesktopMode"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="🖥️ Desk"
                    android:textColor="#58a6ff"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnPlugins"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="🔌 Plugin"
                    android:textColor="#3fb950"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="📋 Log"
                    android:textColor="#e3b341"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Toggle Button to Show/Hide Toolbar and Drag around -->
        <Button
            android:id="@+id/btnToggleBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_floating_toggle"
            android:elevation="10dp"
            android:text="⚙️"
            android:textColor="#f0f6fc"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Loading & Live Debug Console Layout -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminate="true"
                android:indeterminateTint="#58a6ff" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/loadingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booting DeepSeek Harness Engine..."
                    android:textColor="#f0f6fc"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extracting and executing on-device..."
                    android:textColor="#8b949e"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnConfig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Node"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="REAL-TIME ENGINE LOGS:"
            android:textColor="#58a6ff"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Scrollable live log console view -->
        <ScrollView
            android:id="@+id/logScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#05070a"
            android:padding="8dp">

            <TextView
                android:id="@+id/debugLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="[INIT] Initializing Android environment...\n"
                android:textColor="#3fb950"
                android:textSize="11sp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCopyLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Copy Logs"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Restart Engine"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCloseLogs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Show Web"
                android:visibility="gone"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
