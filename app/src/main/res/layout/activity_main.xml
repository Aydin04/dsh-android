<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d1117">

    <!-- WebView Container -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Draggable Floating Container -->
    <LinearLayout
        android:id="@+id/floatingDraggableContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Horizontal Scrollable Toolbar to prevent any button from clipping -->
        <HorizontalScrollView
            android:id="@+id/controlBarScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_bar"
            android:elevation="9dp"
            android:fadeScrollbars="true"
            android:overScrollMode="never"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/controlBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Explicit Close / Minimize Button -->
                <Button
                    android:id="@+id/btnCloseBar"
                    android:layout_width="32dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="✕"
                    android:textColor="#f85149"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="#30363d" />

                <Button
                    android:id="@+id/btnZoomOut"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="-"
                    android:textColor="#58a6ff"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvZoomLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="100%"
                    android:textColor="#f0f6fc"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnZoomIn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="+"
                    android:textColor="#58a6ff"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="#30363d" />

                <!-- Web Dashboard Switcher -->
                <Button
                    android:id="@+id/btnAtomicRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="🔀 AtomicRoute"
                    android:textColor="#f778ba"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="#30363d" />

                <!-- Backup & Database Management -->
                <Button
                    android:id="@+id/btnBackup"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="💾 Data / DB"
                    android:textColor="#58a6ff"
                    android:textSize="11sp" />

                <!-- In-App File Manager & Editor -->
                <Button
                    android:id="@+id/btnFileManager"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="📁 Files"
                    android:textColor="#26a69a"
                    android:textStyle="bold"
                    android:textSize="11sp" />

                <!-- Config & Presets -->
                <Button
                    android:id="@+id/btnConfigDoc"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="📝 Config"
                    android:textColor="#e3b341"
                    android:textSize="11sp" />

                <!-- Plugins -->
                <Button
                    android:id="@+id/btnPlugins"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="🔌 Plugins"
                    android:textColor="#3fb950"
                    android:textSize="11sp" />

                <!-- System Controls -->
                <Button
                    android:id="@+id/btnRefreshWeb"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="🔄"
                    android:textColor="#f0f6fc"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnDesktopMode"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="🖥️ Desk"
                    android:textColor="#79c0ff"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnRootToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="👑 Root"
                    android:textColor="#d2a8ff"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnBubbleToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="🫧 Bubble"
                    android:textColor="#7ee787"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnNode"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="🌐 Node"
                    android:textColor="#58a6ff"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="📋 Log"
                    android:textColor="#e3b341"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Toggle Button to Show/Hide Toolbar and Drag around -->
        <ImageButton
            android:id="@+id/btnToggleBar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_floating_toggle"
            android:contentDescription="Menu"
            android:elevation="10dp"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="#58a6ff" />
    </LinearLayout>

    <!-- Aesthetic Splash & Live Booting Layout -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D1117"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="DeepSeek"
            android:src="@drawable/ic_deepseek" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DeepSeek Harness"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="On-Device Autonomous AI Agent"
            android:textColor="#8B949E"
            android:textSize="13sp" />

        <!-- 0-100% Progress Bar Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ProgressBar
                android:id="@+id/progressBarPercent"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="10"
                android:progressBackgroundTint="#21262D"
                android:progressTint="#4D6BFE" />

            <TextView
                android:id="@+id/tvProgressPercent"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="10%"
                android:textColor="#58A6FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Aesthetic Single Line Rotating Log Status -->
        <TextView
            android:id="@+id/tvCurrentLogLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="middle"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:text="[INIT] Memulai Engine..."
            android:textColor="#3FB950"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <!-- Hidden detailed console (accessible on click or error) -->
        <ScrollView
            android:id="@+id/logScrollView"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="16dp"
            android:background="#05070a"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/debugLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="[INIT] Initializing Android environment...\n"
                android:textColor="#3fb950"
                android:textSize="11sp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnConfig"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackground"
                android:text="🌐 Hubungkan Node / VPS"
                android:textColor="#58A6FF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnShowAllLogs"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackground"
                android:text="📋 Detail Log"
                android:textColor="#8B949E"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/logActionsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnCopyLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Copy Logs"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Restart Engine"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCloseLogs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Tutup"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
