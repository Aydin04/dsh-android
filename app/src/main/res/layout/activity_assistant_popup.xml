<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/assistantRootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/assistantBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#1A1B26"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="#414868" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_deepseek"
                android:contentDescription="Assistant Logo" />

            <TextView
                android:id="@+id/tvAssistantTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="🤖 DSH Assistant"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnModeToggle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="⚡ Temp"
                android:textColor="#F778BA"
                android:textSize="12sp"
                app:strokeColor="#F778BA" />

            <ImageButton
                android:id="@+id/btnExpandFull"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_crop"
                android:tint="#7AA2F7"
                android:contentDescription="Buka Full DSH" />

            <ImageButton
                android:id="@+id/btnCloseAssistant"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#787C99"
                android:contentDescription="Tutup" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/actionPillsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pillScreenshot"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#24283B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="📸 Screenshot Layar"
                    android:textColor="#73DACA"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/pillPickImage"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#24283B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="🖼️ Pilih Gambar"
                    android:textColor="#7AA2F7"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/pillPresetGame"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#24283B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="🎮 Game Boost"
                    android:textColor="#BB9AF7"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/pillSchedule"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#24283B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="⏰ Jadwal / Alarm"
                    android:textColor="#E0AF68"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/pillCleanRam"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#24283B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="🧹 Clean RAM"
                    android:textColor="#9ECE6A"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/pillToggleWifi"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#24283B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="📡 WiFi"
                    android:textColor="#2AC3DE"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/pillAirplane"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#24283B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="✈️ Airplane"
                    android:textColor="#F778BA"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/responseScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:maxHeight="260dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvAssistantResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#24283B"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:text="Halo! Saya asisten DSH Anda. Tanyakan apa saja, jalankan perintah sistem, atau kirim gambar langsung dari galeri / screenshot."
                android:textColor="#C0CAF5"
                android:textSize="14sp" />
        </ScrollView>

        <!-- Image Attachment Preview Thumbnail Bar -->
        <LinearLayout
            android:id="@+id/layoutAttachedImagePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#24283B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivAttachedThumbnail"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_deepseek"
                android:contentDescription="Thumbnail Gambar" />

            <TextView
                android:id="@+id/tvAttachedImageName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="📸 screenshot.png terlampir"
                android:textColor="#73DACA"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnRemoveAttachedImage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#F778BA"
                android:contentDescription="Hapus Lampiran" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnAttachImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_gallery"
                android:tint="#7AA2F7"
                android:contentDescription="Lampirkan Gambar" />

            <ImageButton
                android:id="@+id/btnVoiceInput"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="#BB9AF7"
                android:contentDescription="Voice Input" />

            <EditText
                android:id="@+id/etAssistantInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#24283B"
                android:hint="Ketik pesan atau jelaskan gambar..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#565F89"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnAssistantSend"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_send"
                android:tint="#73DACA"
                android:contentDescription="Kirim" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
