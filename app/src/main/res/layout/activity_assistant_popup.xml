<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/assistantRootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/assistantBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#16161E"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="invisible">

        <!-- Top Drag Handle Pill -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:background="#3B4261" />

        <!-- Header Bar with Quick Action Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_deepseek"
                android:contentDescription="DeepSeek Logo" />

            <TextView
                android:id="@+id/tvAssistantTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="DSH Assistant"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Presets Menu Dropdown Button -->
            <Button
                android:id="@+id/btnPresetsDropdown"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="⚡ Presets"
                android:textColor="#BB9AF7"
                android:textSize="11sp"
                app:strokeColor="#BB9AF7" />

            <!-- Cron / Scheduler Dropdown Button -->
            <Button
                android:id="@+id/btnCronDropdown"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="⏰ Cron"
                android:textColor="#7AA2F7"
                android:textSize="11sp"
                app:strokeColor="#7AA2F7" />

            <!-- Screenshot Action Button -->
            <ImageButton
                android:id="@+id/btnAttachScreenshot"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_camera"
                android:tint="#73DACA"
                android:contentDescription="Screenshot Layar" />

            <!-- Expand Button (Open Full Web App) -->
            <ImageButton
                android:id="@+id/btnExpandFull"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_crop"
                android:tint="#7AA2F7"
                android:contentDescription="Buka Full DSH" />

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/btnCloseAssistant"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#787C99"
                android:contentDescription="Tutup" />
        </LinearLayout>

        <!-- Official DSH Embedded WebView Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:background="#13141F">

            <WebView
                android:id="@+id/assistantWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#13141F" />

            <ProgressBar
                android:id="@+id/assistantWebLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="#58A6FF" />
        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
